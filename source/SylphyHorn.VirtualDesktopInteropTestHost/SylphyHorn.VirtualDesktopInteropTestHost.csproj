<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <AssemblyName>SylphyHorn.VirtualDesktopInteropTestHost</AssemblyName>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <IsPackable>false</IsPackable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VirtualDesktop\source\VirtualDesktop\VirtualDesktop.csproj" />
  </ItemGroup>

  <Target Name="GetAppHostPath" DependsOnTargets="Build" Returns="@(_AppHostPath)">
    <ItemGroup>
      <_AppHostPath Include="$(TargetDir)$(TargetName).exe" />
    </ItemGroup>
  </Target>

</Project>
