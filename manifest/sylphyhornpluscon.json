{
  "manifestVersion": 1,
  "id": "sylphyhornpluscon",
  "name": "SylphyHornPlusCon",
  "version": "1.0.0",
  "description": "SylphyHornPlusCon virtual desktop control and state profile for Socket Universe Module.",
  "vppVersion": 1,
  "namespace": "shpc",
  "sourceApp": "SocketUniverseModule",
  "peerLabel": "SylphyHornPlusCon",
  "configFields": [],
  "variables": [
    { "id": "connected", "name": "SUB connected (1/0)", "role": "serverConnected" },
    { "id": "shpc_connected", "name": "SylphyHornPlusCon mailbox connected (1/0)", "role": "peerConnected" },
    { "id": "connection_state", "name": "Connection state", "role": "connectionState" },
    { "id": "diagnostic_level", "name": "Diagnostic level (green/yellow/red/gray)", "role": "diagnosticLevel" },
    { "id": "diagnostic_status", "name": "Diagnostic overall status", "role": "diagnosticStatus" },
    { "id": "diagnostic_sub", "name": "Diagnostic SUB status", "role": "diagnosticServer" },
    { "id": "diagnostic_shpc", "name": "Diagnostic SylphyHornPlusCon status", "role": "diagnosticPeer" },
    { "id": "diagnostic_reason", "name": "Diagnostic reason", "role": "diagnosticReason" },
    { "id": "heartbeat_interval_ms", "name": "Heartbeat interval ms", "role": "heartbeatInterval" },
    { "id": "protocol_version", "name": "Protocol version", "role": "protocolVersion" },
    { "id": "id", "name": "Message ID", "role": "messageId" },
    { "id": "correlation_id", "name": "Correlation ID", "role": "correlationId" },
    { "id": "type", "name": "Message type", "role": "messageType" },
    { "id": "from", "name": "From mailbox", "role": "from" },
    { "id": "recipient", "name": "Recipient mailbox", "role": "recipient" },
    { "id": "method", "name": "Call method", "role": "method" },
    { "id": "event", "name": "Event name", "role": "event" },
    { "id": "data", "name": "Data JSON", "role": "data" },
    { "id": "result", "name": "Result JSON", "role": "result" },
    { "id": "error_code", "name": "Error code", "role": "errorCode" },
    { "id": "error_message", "name": "Error message", "role": "errorMessage" },
    { "id": "error_details", "name": "Error details JSON", "role": "errorDetails" },
    { "id": "source_app", "name": "Source application", "role": "sourceApp" },
    { "id": "source_version", "name": "Source application version", "role": "sourceVersion" },
    { "id": "source_instance", "name": "Source instance", "role": "sourceInstance" },
    { "id": "timestamp", "name": "Protocol timestamp", "role": "timestamp" },
    { "id": "payload", "name": "Complete JSON payload", "role": "payload" },
    { "id": "last_received", "name": "Local receive timestamp", "role": "lastReceived" },
    { "id": "last_sent", "name": "Local send timestamp", "role": "lastSent" },
    { "id": "protocol_error", "name": "Last VPP validation error", "role": "protocolError" },
    { "id": "control_enabled", "name": "SHPC remote control enabled" },
    { "id": "individual_wallpapers", "name": "Individual wallpapers enabled" },
    { "id": "current_desktop_id", "name": "Current desktop GUID" },
    { "id": "current_cname", "name": "Current desktop canonical name" },
    { "id": "current_title", "name": "Current desktop title" },
    { "id": "current_position", "name": "Current desktop position" },
    { "id": "desktop_count", "name": "Desktop count" },
    { "id": "desktops_json", "name": "Desktop state list JSON" }
  ],
  "dynamicVariables": [],
  "settings": {},
  "memory": {},
  "events": {
    "desktopStateChanged": {
      "operation": "mapArgsToVariables",
      "expectsResponse": false,
      "args": {
        "enabled": { "type": "boolean" },
        "individualWallpapersEnabled": { "type": "boolean" },
        "currentDesktopId": { "type": "string" },
        "currentCName": { "type": "string" },
        "currentTitle": { "type": "string" },
        "currentPosition": { "type": "integer" },
        "desktopCount": { "type": "integer" },
        "desktopsJson": { "type": "string" }
      },
      "map": {
        "enabled": "control_enabled",
        "individualWallpapersEnabled": "individual_wallpapers",
        "currentDesktopId": "current_desktop_id",
        "currentCName": "current_cname",
        "currentTitle": "current_title",
        "currentPosition": "current_position",
        "desktopCount": "desktop_count",
        "desktopsJson": "desktops_json"
      }
    }
  },
  "replays": {},
  "actions": {
    "activate_desktop_cname": {
      "name": "Desktop: Activate by Name",
      "operation": "call",
      "method": "activateDesktop",
      "expectsResponse": true,
      "queue": { "policy": "replace", "key": "desktop.activate" },
      "options": [
        { "type": "textinput", "id": "cname", "label": "Desktop Name", "default": "", "useVariables": true, "multiline": false, "arg": "cname", "parse": "string" }
      ]
    },
    "activate_desktop_position": {
      "name": "Desktop: Activate by Position",
      "operation": "call",
      "method": "activateDesktop",
      "expectsResponse": true,
      "queue": { "policy": "replace", "key": "desktop.activate" },
      "options": [
        { "type": "textinput", "id": "position", "label": "Position", "default": "1", "useVariables": true, "multiline": false, "arg": "position", "parse": "integer" }
      ]
    },
    "add_desktop": {
      "name": "Desktop: Add",
      "operation": "call",
      "method": "addDesktop",
      "expectsResponse": true,
      "queue": { "policy": "fifo" },
      "options": [
        { "type": "textinput", "id": "position", "label": "Position (0 = end)", "default": "0", "useVariables": true, "multiline": false, "arg": "position", "parse": "integer" }
      ]
    },
    "individual_wallpapers": {
      "name": "Desktop: Individual Wallpapers",
      "operation": "call",
      "method": "setIndividualWallpapers",
      "expectsResponse": true,
      "queueByOption": { "option": "state", "fifoValues": ["toggle"], "replaceKey": "desktop.individualWallpapers" },
      "options": [
        { "type": "dropdown", "id": "state", "label": "State", "default": "toggle", "arg": "state", "parse": "enum", "values": ["on", "off", "toggle"], "choices": [{ "id": "on", "label": "On" }, { "id": "off", "label": "Off" }, { "id": "toggle", "label": "Toggle" }] }
      ]
    },
    "desktop_wallpaper_cname": {
      "name": "Desktop: Wallpaper by Name",
      "operation": "call",
      "method": "setDesktopWallpaper",
      "expectsResponse": true,
      "queue": { "policy": "fifo" },
      "options": [
        { "type": "textinput", "id": "cname", "label": "Desktop Name", "default": "", "useVariables": true, "multiline": false, "arg": "cname", "parse": "string" },
        { "type": "dropdown", "id": "state", "label": "State", "default": "toggle", "arg": "state", "parse": "enum", "values": ["on", "off", "toggle"], "choices": [{ "id": "on", "label": "On" }, { "id": "off", "label": "Off" }, { "id": "toggle", "label": "Toggle" }] }
      ]
    },
    "desktop_wallpaper_position": {
      "name": "Desktop: Wallpaper by Position",
      "operation": "call",
      "method": "setDesktopWallpaper",
      "expectsResponse": true,
      "queue": { "policy": "fifo" },
      "options": [
        { "type": "textinput", "id": "position", "label": "Position", "default": "1", "useVariables": true, "multiline": false, "arg": "position", "parse": "integer" },
        { "type": "dropdown", "id": "state", "label": "State", "default": "toggle", "arg": "state", "parse": "enum", "values": ["on", "off", "toggle"], "choices": [{ "id": "on", "label": "On" }, { "id": "off", "label": "Off" }, { "id": "toggle", "label": "Toggle" }] }
      ]
    },
    "get_desktop_state": {
      "name": "Desktop: Get State",
      "operation": "call",
      "method": "getDesktopState",
      "expectsResponse": true,
      "queue": { "policy": "replace", "key": "desktop.getState" },
      "options": []
    },
    "get_desktop_cname": {
      "name": "Desktop: Get by Name",
      "operation": "call",
      "method": "getDesktop",
      "expectsResponse": true,
      "queue": { "policy": "replace", "keyTemplate": "desktop.get.{cname}" },
      "options": [
        { "type": "textinput", "id": "cname", "label": "Desktop Name", "default": "", "useVariables": true, "multiline": false, "arg": "cname", "parse": "string" }
      ]
    }
  },
  "presets": []
}
