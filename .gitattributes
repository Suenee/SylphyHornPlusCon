###############################################################################
# Set default behavior to automatically normalize line endings.
###############################################################################
#* text=auto

###############################################################################
# Windows launch and maintenance scripts must use CRLF.
###############################################################################
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

###############################################################################
# Set default behavior for command prompt diff.
###############################################################################
#*.cs     diff=csharp
*.cs      whitespace=cr-at-eol
.gitattributes whitespace=cr-at-eol
.gitignore whitespace=cr-at-eol
*.pubxml whitespace=cr-at-eol
*.csproj whitespace=cr-at-eol
*.md whitespace=cr-at-eol

